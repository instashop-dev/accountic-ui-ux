---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const pageTitle = `Sign in · ${SITE_TITLE}`;
const pageDescription =
	'Sign in to Accountic — the AI workbench for Indian CA firms. Continue to the app to access your workspace.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
	</head>
	<body>
		<Header />

		<main class="auth">
			<div class="container auth-container">
				<section class="auth-card" aria-label="Sign in">
					<div class="auth-brand" aria-hidden="true">
						<svg class="auth-logo" viewBox="0 0 32 32" width="36" height="36" fill="none" xmlns="http://www.w3.org/2000/svg">
							<rect class="auth-logo-bg" x="1" y="1" width="30" height="30" rx="9" />
							<g class="auth-logo-mark" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" fill="none">
								<path d="M8.5 23 L16 9 L23.5 23" />
								<path d="M13.5 16 L18.5 16" />
								<path d="M12 19 L20 19" />
							</g>
						</svg>
					</div>

					<h1>Welcome back.</h1>
					<p class="auth-sub">Your Accountic workspace lives in the app. Continue to sign in.</p>

					<a class="btn btn-primary auth-submit" href="https://app.accountic.in/login">
						Continue to Accountic
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
						</svg>
					</a>

					<p class="auth-note">Sign in with your password or a one-time SMS code sent to the mobile number on your account.</p>

					<p class="auth-alt">
						New to Accountic?
						<a href="https://app.accountic.in/signup">Start free</a> — ₹1,000 in credits, no card required.
					</p>
				</section>

				<ul class="auth-trust" aria-label="Compliance">
					<li>
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
							<path d="m9 12 2 2 4-4"/>
						</svg>
						SOC 2 Type II infra
					</li>
					<li>
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<rect x="4" y="11" width="16" height="10" rx="2"/>
							<path d="M8 11V7a4 4 0 0 1 8 0v4"/>
						</svg>
						DPDP-ready
					</li>
					<li>
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="12" cy="12" r="9"/>
							<path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>
						</svg>
						India-resident data
					</li>
					<li>
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
							<circle cx="9" cy="7" r="4"/>
							<path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
						</svg>
						Built by CAs &amp; engineers
					</li>
				</ul>
			</div>
		</main>

		<Footer />

		<style>
			.auth {
				position: relative;
				min-height: calc(100dvh - 80px);
				padding: 7rem 0 4rem;
				background-color: var(--color-paper);
				display: flex;
				align-items: center;
			}

			.auth-container {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: var(--space-lg);
			}

			.auth-card {
				width: 100%;
				max-width: 440px;
				background: var(--color-paper);
				border: 1px solid var(--color-rule);
				border-radius: var(--radius-lg);
				padding: clamp(1.75rem, 4vw, 2.5rem);
				position: relative;
			}

			.auth-brand {
				display: inline-flex;
				margin-bottom: 1.25rem;
				padding: var(--space-2xs);
			}

			/* Brand logo — colors routed through Cobalt tokens (no inline hex). */
			.auth-logo-bg { fill: var(--color-accent); }
			.auth-logo-mark { stroke: var(--color-accent-ink); }

			.auth-card h1 {
				font-size: clamp(1.6rem, 3vw, 2rem);
				margin: 0 0 0.35rem;
				letter-spacing: -0.02em;
			}

			.auth-sub {
				color: var(--color-ink-4);
				margin: 0 0 var(--space-lg);
				font-size: 0.95rem;
			}

			.auth-note {
				margin: var(--space-md) 0 0;
				font-size: 0.85rem;
				line-height: 1.5;
				color: var(--color-ink-4);
			}

			/* SSO */
			.auth-sso {
				display: grid;
				gap: var(--space-xs);
				margin-bottom: var(--space-md);
			}

			.sso-btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 0.6rem;
				min-height: 44px;
				padding: 0.6rem 1rem;
				border: 1px solid var(--color-border-control);
				background: var(--color-paper);
				border-radius: var(--radius-sm);
				color: var(--color-ink);
				font-family: inherit;
				font-size: 0.9rem;
				font-weight: 500;
				cursor: pointer;
				transition: background 180ms ease, border-color 180ms ease;
			}

			.sso-btn:hover {
				background: var(--color-paper-2);
				border-color: var(--color-accent);
			}

			.sso-btn svg { flex-shrink: 0; }

			/* Divider */
			.auth-divider {
				display: flex;
				align-items: center;
				gap: var(--space-sm);
				font-family: var(--font-mono);
				color: var(--color-ink-4);
				font-size: 0.68rem;
				letter-spacing: var(--tracking-label);
				text-transform: uppercase;
				margin: var(--space-md) 0;
			}

			.auth-divider::before,
			.auth-divider::after {
				content: '';
				flex: 1;
				height: 1px;
				background: var(--color-rule);
			}

			/* Form */
			.auth-form { display: grid; gap: 0.85rem; }

			.auth-field { display: grid; gap: 0.4rem; }

			.auth-label {
				display: flex;
				justify-content: space-between;
				font-size: 0.85rem;
				color: var(--color-ink);
				font-weight: 500;
			}

			.auth-aux {
				font-size: 0.8rem;
				color: var(--color-accent-2);
				font-weight: 500;
			}

			.auth-aux:hover { color: var(--color-accent); }

			.auth-field input {
				padding: 0.8rem 1rem;
				font-size: 0.95rem;
				font-family: inherit;
				border: 1px solid var(--color-border-control);
				border-radius: var(--radius-sm); /* tight technical radius — never pill on data fields */
				background: var(--color-paper);
				color: var(--color-ink);
				min-height: 46px;
				width: 100%;
				transition: border-color 180ms ease, box-shadow 180ms ease;
			}

			.auth-field input::placeholder { color: var(--color-ink-4); }

			/* Focus uses the global cobalt ring from global.css. */

			.auth-pwd {
				position: relative;
				display: flex;
				align-items: center;
			}

			.auth-pwd input { padding-right: 3rem; }

			.pwd-toggle {
				position: absolute;
				right: 0.35rem;
				top: 50%;
				transform: translateY(-50%);
				width: 36px;
				height: 36px;
				border-radius: var(--radius-sm);
				border: none;
				background: transparent;
				color: var(--color-ink-4);
				display: inline-flex;
				align-items: center;
				justify-content: center;
				cursor: pointer;
				transition: background 180ms ease, color 180ms ease;
			}

			.pwd-toggle:hover {
				background: var(--color-paper-2);
				color: var(--color-ink);
			}

			.auth-remember {
				display: flex;
				align-items: center;
				gap: 0.55rem;
				font-size: 0.88rem;
				color: var(--color-ink-3);
				margin: 0.15rem 0 0.25rem;
				cursor: pointer;
				user-select: none;
			}

			.auth-remember input {
				width: 16px;
				height: 16px;
				accent-color: var(--color-accent);
				margin: 0;
				cursor: pointer;
			}

			.auth-submit {
				min-height: 48px;
				width: 100%;
				margin-top: 0.35rem;
			}

			.auth-alt {
				text-align: center;
				font-size: 0.88rem;
				color: var(--color-ink-4);
				margin: 1.25rem 0 0;
			}

			.auth-alt a {
				color: var(--color-accent-2);
				font-weight: 500;
			}

			.auth-alt a:hover { color: var(--color-accent); }

			/* Trust row below card */
			.auth-trust {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: var(--space-lg);
				font-family: var(--font-mono);
				font-size: 0.72rem;
				letter-spacing: var(--tracking-label);
				text-transform: uppercase;
				color: var(--color-ink-4);
			}

			.auth-trust li {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
			}

			.auth-trust svg { color: var(--color-ink-3); flex-shrink: 0; }

			@media (max-width: 560px) {
				.auth { padding: 6rem 0 3rem; }
				.auth-trust { gap: 0.75rem 1rem; font-size: 0.66rem; }
				.auth-trust li svg { width: 12px; height: 12px; }
			}
		</style>

	</body>
</html>
